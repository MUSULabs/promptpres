# Copy to .env (never commit .env). Leave secrets empty here.

# --- LLM: calls go through OpenRouter only (vault D-037) ---
OPENROUTER_API_KEY=
# Pin an exact model id (no preview / floating alias); it is logged in versions.llm.
OPENROUTER_MODEL=
# Monthly budget cap: 10 USD - set the same limit on the key in the OpenRouter dashboard.

# --- Database (the queue is the sessions table; there is no Redis) ---
# Local runs use SQLite data/promptpres.db. The app loads ONLY the OpenRouter keys from this file, so a
# DATABASE_URL written here never reaches local runs or tests; set it in your shell to point the host worker
# at the docker-compose PostgreSQL, e.g.
#   DATABASE_URL=postgresql://promptpres:promptpres@localhost:5432/promptpres python -m worker.runner
# D-062 cloud: put the Supabase Session Pooler URL (port 5432, ?sslmode=require) here as DATABASE_URL;
# tools/set_modal_secret.ps1 reads it from this file into the Modal Secret without printing it.
# DATABASE_URL=postgresql://<user>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Optional ---
# Any local mp4 to play on mock result pages
PROMPTPRES_MOCK_VIDEO=
# Config file names inside config/ (defaults shown)
PROMPTPRES_THRESHOLDS=thresholds-v0.yaml
PROMPTPRES_FEEDBACK=feedback-v0.yaml
# D-050 Cloud settings (example only; never put real keys in git)
PROMPTPRES_REQUIRE_LOGIN=0
# PROMPTPRES_SESSION_SECRET=<persistent random value, at least 32 characters>
# PT_AUTH_SECRET in DEPLOY_RUNBOOK.md is an operator shell variable, not an app setting.
# PROMPTPRES_PUBLIC_ORIGIN=https://www.promptpres.app,https://promptpres.app,https://promptpres.vercel.app   (comma-separated web origins; the first is canonical; promptpres.app redirects to www)
# PROMPTPRES_DIRECT_ORIGIN=https://<workspace>--promptpres-web.us-east.modal.run   (D-062: upload chunks + player)
# PROMPTPRES_TRUSTED_PROXY=1        (Compose: one reverse proxy, rate limit by the last X-Forwarded-For)
# PROMPTPRES_TRUSTED_PROXY=vercel   (Modal behind Vercel: rate limit by x-real-ip)
# PROMPTPRES_STORAGE=storage-v0.yaml   (playback copy, retention, upload chunk size)
# PROMPTPRES_DATA=/data
# PROMPTPRES_MODELS=/models
# POSTGRES_PASSWORD=<URL-safe database password for Compose>
